{
  "contract_version": 3,
  "product_name": "nddev-junie-cli-app",
  "github_repository": "NDDev-it-com/nddev-junie-cli-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "managed_state": {
    "stamp_file": "NDDEV-JUNIE-CLI-SETUP.json",
    "stamp_schema": 3,
    "legacy_stamp_schemas_readable": [1, 2],
    "default_target": null,
    "environment_variable": null,
    "managed_directory_mode": "0700",
    "managed_file_mode": "0600",
    "lock_directory": "<target>/.nddev-junie-cli.lock",
    "backup_directory": "<target>/.nddev-junie-cli-backups",
    "preserve_other_state": true,
    "control_root": "explicit --target, also passed as Junie --project",
    "runtime_home": "<target>/.nddev-junie-cli-runtime/home",
    "pathless_native_state": {
      "allowlist": "<target>/.nddev-junie-cli-runtime/home/.junie/allowlist.json"
    },
    "co_owned_config_strategy": "schema-3 config and runtime allowlist are complete managed JSON files; legacy schema-1 co-owned files and schema-2 coupled setup files are readable only for status, migrate, restore, and remove",
    "identity_fields": {
      "setup_id": "nddev-builder",
      "profile_id": "safe or full-auto"
    }
  },
  "setup_system": {
    "catalog_root": "setups",
    "setup_ids": ["nddev-builder"],
    "default_setup_id": "nddev-builder",
    "content_setup": "nddev-builder",
    "identity_source": "official Junie CLI docs and installer scripts from junie.jetbrains.com",
    "list_command": "python3 cli-tools/nddev_junie_cli.py list --json",
    "status_command": "python3 cli-tools/nddev_junie_cli.py status --target /absolute/target --json",
    "plan_command": "python3 cli-tools/nddev_junie_cli.py plan --setup nddev-builder --profile full-auto --target /absolute/target --json",
    "install_command": "python3 cli-tools/nddev_junie_cli.py install --setup nddev-builder --profile full-auto --target /absolute/target --json",
    "switch_command": "python3 cli-tools/nddev_junie_cli.py switch --setup nddev-builder --profile safe --target /absolute/target --json",
    "migrate_command": "python3 cli-tools/nddev_junie_cli.py migrate --setup nddev-builder --profile full-auto --target /absolute/target --json",
    "restore_command": "python3 cli-tools/nddev_junie_cli.py restore --backup 0 --target /absolute/target --json",
    "remove_command": "python3 cli-tools/nddev_junie_cli.py remove --target /absolute/target --json",
    "launch_command": "python3 cli-tools/nddev_junie_cli.py launch --target /absolute/target --"
  },
  "permission_profiles": {
    "catalog_root": "profiles",
    "profile_ids": ["safe", "full-auto"],
    "default_profile_id": "full-auto",
    "safe": {
      "native_brave": false,
      "allowlist": "ask-first empty allow rules"
    },
    "full-auto": {
      "native_brave": true,
      "allowlist": "minimal managed allowlist; Brave On carries the permission posture"
    },
    "unsupported": {
      "auto": "Brave Auto exists in the UI, but no stable config/env schema for selecting it is confirmed."
    }
  },
  "safety": {
    "absolute_target_required": true,
    "relative_target_rejected": true,
    "target_symlinks_rejected": true,
    "managed_symlinks_rejected": true,
    "managed_hardlinks_rejected": true,
    "bounded_managed_reads": true,
    "canonical_target_binding": true,
    "rollback_on_failure": true,
    "max_backups": 10,
    "launch_requires_clean_managed_target": true,
    "launch_requires_schema_3": true,
    "launch_strips_provider_credentials": true,
    "lock_and_backup_roots_inside_private_target": true,
    "subprocess_path": "/usr/bin:/bin:/usr/sbin:/sbin",
    "launch_holds_target_lock_until_child_exit": true,
    "launch_blocks_lifecycle_mutations_while_child_runs": true
  },
  "software_lifecycle": {
    "installer_url": "https://junie.jetbrains.com/install.sh",
    "installer_sha256": "a37b9ce2d7bdacdcccd59afd6b8a84d96d2349a5ab6a3707c83f5b731af294bd",
    "version": "2383.10",
    "marketing_version": "26.7.20",
    "update_info": "https://raw.githubusercontent.com/jetbrains-junie/junie/main/update-info.jsonl",
    "install_only_absent": true,
    "update_repairs_safe_partial": true,
    "update_command": "python3 cli-tools/nddev_junie_cli.py update --target /absolute/target --json",
    "installer_execution_home": "isolated staging HOME",
    "source_overrides": false,
    "test_environment_overrides": false,
    "persisted_runtime": ".nddev-junie-cli-runtime/home",
    "status_executes_target_binary": false,
    "stage_version_probe_only": true
  },
  "runtime_compatibility": {
    "baseline_ref": "references/junie-cli-baseline.json",
    "command": "junie",
    "channel": "release",
    "tested_release": "2383.10",
    "marketing_version": "26.7.20",
    "exact_artifact_hashes_available": true,
    "supported_platforms": ["linux-aarch64", "linux-amd64", "macos-aarch64", "macos-amd64"]
  },
  "runtime_launch": {
    "command": "junie",
    "direct_command": ["junie", "--skip-update-check"],
    "manager_command": "python3 cli-tools/nddev_junie_cli.py launch --target /absolute/target --",
    "required_version": "2383.10",
    "environment_variable": null,
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "streams_child_stdio": true,
    "json_manager_errors_supported": true,
    "target_environment_scope": "T is the explicit control/project root; H is T/.nddev-junie-cli-runtime/home; Junie receives exact target-owned config, guidelines, skills, agents, MCP, commands, hooks, extensions cache, cache, temp, HOME, XDG, data, logs, and JVM home/tmp scopes",
    "live_home_guard": "account ~/.junie metadata must remain unchanged across installer probes and launches",
    "lock_scope": "target-internal lifecycle lock is held from launch preflight through child completion, post-launch live-home assertion, and lock cleanup",
    "pre_child_artifact_revalidation": "target-owned Junie shim and pinned Junie binary path, inode, size, and SHA256 are captured during launch preflight and revalidated immediately before subprocess execution",
    "managed_scope_flags": [
      "--project",
      "-p",
      "--config-location",
      "--config-default-locations",
      "--guidelines-filename",
      "--skill-location",
      "--skill-default-locations",
      "--agent-location",
      "--agent-default-location",
      "--mcp-location",
      "--mcp-default-locations",
      "--command-location",
      "--command-default-locations",
      "--extensions-default-location",
      "--model-location",
      "--model-default-locations",
      "--model",
      "--effort",
      "--provider",
      "--cache-dir",
      "-c",
      "--auth",
      "-a",
      "--auth-license",
      "--anthropic-api-key",
      "--google-api-key",
      "--grok-api-key",
      "--openai-api-key",
      "--openrouter-api-key"
    ]
  },
  "builder_toolkit": {
    "toolkit_id": "nddev-builder",
    "direct_projection": {
      "guidelines": "AGENTS.md via --guidelines-filename and JUNIE_GUIDELINES_FILENAME",
      "skills": "skills/* via --skill-location and JUNIE_SKILL_LOCATIONS",
      "agents": "agents/*.md via --agent-location and JUNIE_AGENT_LOCATIONS",
      "commands": "commands/*.md via --command-location and JUNIE_COMMAND_LOCATIONS",
      "mcp": "mcp/mcp.json via --mcp-location and JUNIE_MCP_LOCATIONS",
      "hooks": "hooks/*.py through the managed config loaded by --config-location"
    },
    "local_extension_marketplace": {
      "marketplace_manifest": "extensions/nddev-builder-marketplace/.junie-extension/marketplace.json",
      "extension_root": "extensions/nddev-builder-marketplace/extensions/nddev-builder",
      "external_marketplace_published": null,
      "installed_state_generated": false,
      "reason": "Junie documents local marketplace sources and interactive slash-command installation, but no stable noninteractive install command or deterministic installed-reference id for local sources is documented."
    }
  }
}
