{
  "id": "balanced",
  "display_name": "Balanced",
  "description": "Conservative Junie CLI setup that keeps approval prompts while allowing readonly command classification.",
  "brave": false,
  "allow_readonly_commands": true,
  "plan_mode_default": false,
  "nddev_builder_default": true,
  "allowlist": {
    "defaultBehavior": "ask",
    "allowReadonlyCommands": true,
    "rules": {
      "fileEditing": {"rules": []},
      "executables": {
        "rules": [
          {"prefix": "git status", "action": "allow"},
          {"prefix": "git diff", "action": "allow"},
          {"prefix": "ls", "action": "allow"}
        ]
      },
      "mcpTools": {"rules": []},
      "readOutsideProject": {"rules": []}
    }
  }
}
